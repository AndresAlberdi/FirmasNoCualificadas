# ---------------------------------------------------------------------------
# Configuración del servicio PSCNC. Copiar a .env y completar por entorno.
# NUNCA versionar el archivo .env resultante.
# ---------------------------------------------------------------------------

# Entorno lógico: sandbox | dev | staging | prod
PSCNC_ENVIRONMENT=dev

# Backend criptográfico: kms (producción) | local (solo desarrollo, clave en archivo)
PSCNC_CRYPTO_BACKEND=local

# --- AWS ---------------------------------------------------------------------
AWS_REGION=us-east-1
PSCNC_KMS_CA_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-000000000000
PSCNC_KMS_SIGNING_ALGORITHM=RSASSA_PKCS1_V1_5_SHA_256
PSCNC_AUDIT_TABLE=PSCNC_Audit_Trail
PSCNC_SIGNED_BUCKET=pscnc-paraguay-signed-vault
PSCNC_EVIDENCE_BUCKET=pscnc-paraguay-evidence-trail
PSCNC_PRESIGNED_URL_TTL=300

# --- Identidad de la CA intermedia (Res. MIC 262/2024, DOC-ICPP-20) ----------
PSCNC_CA_COMMON_NAME=CA Intermedia FENC - <RAZON SOCIAL> S.A.
PSCNC_CA_ORGANIZATION=<RAZON SOCIAL> S.A.
PSCNC_CA_ORGANIZATION_IDENTIFIER=VATPY-<RUC>
PSCNC_CA_COUNTRY=PY
PSCNC_CA_CERT_PATH=/etc/pscnc/ca-intermediate.crt
PSCNC_CRL_DISTRIBUTION_URL=https://crl.example.com.py/pscnc/intermediate.crl
PSCNC_CERT_POLICY_OID=1.3.6.1.4.1.00000.1.1.1

# Vigencia del certificado efímero del firmante (minutos)
PSCNC_EPHEMERAL_CERT_BACKDATE_MINUTES=5
PSCNC_EPHEMERAL_CERT_VALIDITY_MINUTES=15

# --- Autoridad de Sellado de Tiempo cualificada (PCSC habilitado en PY) ------
PSCNC_TSA_URL=https://tsa.proveedor.com.py/tsa
PSCNC_TSA_PROVIDER_NAME=<PCSC CUALIFICADO>
PSCNC_TSA_USERNAME=
PSCNC_TSA_PASSWORD=
PSCNC_TSA_TIMEOUT_SECONDS=10

# --- Integración con el módulo de Onboarding existente -----------------------
PSCNC_ONBOARDING_BASE_URL=https://onboarding.interno.example.com
PSCNC_ONBOARDING_API_KEY=
PSCNC_MIN_FACIAL_MATCH_SCORE=0.95

# --- Seguridad de la API B2B --------------------------------------------------
PSCNC_HMAC_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:pscnc/b2b/hmac
PSCNC_HMAC_MAX_SKEW_SECONDS=300
PSCNC_SESSION_TTL_MINUTES=60
