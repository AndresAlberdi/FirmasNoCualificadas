    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.1.3",
