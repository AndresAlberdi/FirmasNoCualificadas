# Política de cadena de suministro del equipo: los scripts de ciclo de vida de
# las dependencias (preinstall/install/postinstall) NO se ejecutan.
#
# Es el vector de los ataques de paquete comprometido: basta con publicar una
# versión con un postinstall malicioso para ejecutar código arbitrario en la
# máquina de quien instale, y en la del runner de CI. Si algún paquete
# legítimamente necesita su script, se habilita de forma individual y explícita
# con `pnpm approve-builds`, dejando registro en el control de versiones.
ignore-scripts=true

# Falla si el lockfile no coincide con el package.json en lugar de actualizarlo
# en silencio: una dependencia solo cambia por un commit deliberado.
prefer-frozen-lockfile=true
